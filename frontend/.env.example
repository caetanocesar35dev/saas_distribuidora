# URL da API do backend (NestJS). Usada só no servidor do Next (BFF): o navegador nunca fala
# direto com a API e nunca vê os tokens.
API_URL="http://localhost:3001/api"

# Quem opera o sistema, mostrado nos Termos de uso (/termos) e na Política de privacidade
# (/privacidade), exigidos pela LGPD. Lidos só no servidor; sem valor, a página mostra o campo
# entre colchetes. Os textos são um modelo: revise com um advogado antes de usar em produção.
LEGAL_OPERATOR_NAME=""
# CNPJ com ou sem máscara (pode ser alfanumérico)
LEGAL_OPERATOR_CNPJ=""
# E-mail de contato e do encarregado de dados (DPO)
LEGAL_CONTACT_EMAIL=""
# Foro dos termos de uso, ex.: "Recife/PE"
LEGAL_FORUM=""
