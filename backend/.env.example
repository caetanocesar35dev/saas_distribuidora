# Copie para backend/.env e preencha. O .env não vai para o git.

# --- Obrigatórias ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:<senha>@localhost:5437/distribuidora_online"
# Segredo de assinatura dos tokens JWT (você define; sem regra de tamanho).
JWT_SECRET="troque-por-um-segredo-seu"

# --- Sessão ---------------------------------------------------------------------------------
# Validade do access token (JWT). Padrão: 15m
JWT_ACCESS_EXPIRES_IN=15m
# Validade do refresh token, em dias. Padrão: 30
REFRESH_TOKEN_DAYS=30
# Custo do bcrypt. Padrão: 12
BCRYPT_ROUNDS=12

# --- Servidor -------------------------------------------------------------------------------
PORT=3001
# Em PRODUÇÃO são obrigatórias. Em desenvolvimento o padrão é http://localhost:5173.
CORS_ORIGINS="http://localhost:5173"
APP_URL="http://localhost:5173"
APP_TIMEZONE=America/Sao_Paulo

# --- Assinatura -----------------------------------------------------------------------------
# Dias de teste no cadastro. Padrão: 14
TRIAL_DAYS=14
# Dias de acesso completo depois que a mensalidade vence. Padrão: 5
SUBSCRIPTION_GRACE_DAYS=5

# --- Estoque --------------------------------------------------------------------------------
# Limite padrão do alerta de estoque baixo. Padrão: 20
LOW_STOCK_THRESHOLD=20

# --- E-mail (nodemailer) --------------------------------------------------------------------
# Sem EMAIL_USER/EMAIL_PASS nenhum e-mail é enviado: a mensagem (com o link) só aparece no log.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Remetente (padrão: EMAIL_USER)
EMAIL_FROM=

# --- Asaas (só a partir da Fase 10, ainda não implementada) ---------------------------------
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
